{
  "name": "company-lookup-api",
  "version": "0.1.0",
  "description": "A simple API for looking up company information",
  "private": false,
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvilisGlenio/Company-Lookup-API.git"
  },
  "keywords": [],
  "author": "Evilis Glenio",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/EvilisGlenio/Company-Lookup-API/issues"
  },
  "homepage": "https://github.com/EvilisGlenio/Company-Lookup-API#readme",
  "dependencies": {
    "fastify": "^5.12.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
